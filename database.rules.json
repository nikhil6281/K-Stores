{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": false
      }
    },
    "staff": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$key": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('email').val() === auth.token.email || data.child('uid').val() === auth.uid || $key === auth.uid)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "staffInvites": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "staffRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ($uid === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['status', 'requestedAt'])"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email_verified === true",
        ".validate": "newData.hasChildren(['name', 'price']) && newData.child('name').isString() && newData.child('price').isNumber() && newData.child('price').val() >= 0"
      }
    },
    "productImages": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email_verified === true"
      }
    },
    "categories": {
      ".read": true,
      "$categoryId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email_verified === true"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email_verified === true",
      ".validate": "newData.hasChildren(['deliveryFee', 'freeDeliveryThreshold', 'whatsappNumber'])"
    },
    "orders": {
      ".indexOn": [
        "uid",
        "createdAt",
        "paymentStatus"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true || query.orderByChild === 'uid' && query.equalTo === auth.uid)",
      "$orderId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('staff').child(auth.uid).child('active').val() === true && data.exists() && newData.exists() && newData.child('status').val() != 'cancelled' && newData.child('status').val() != 'delivered' && data.child('status').val() != 'cancelled'))",
        "packingChecks": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true)"
        },
        "unavailableItems": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true)"
        },
        "cancellationRequest": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true || data.parent().child('uid').val() === auth.uid)"
        },
        "claimedBy": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true)"
        }
      }
    },
    "orderPrivate": {
      "$orderId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.child('customerUid').val() === auth.uid && root.child('orders').child($orderId).child('status').val() === 'out_for_delivery'))",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "otpChallenges": {
      ".read": false,
      ".write": false
    },
    "audit": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true)",
      "$auditId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('staff').child(auth.uid).child('active').val() === true) && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['adminUid', 'adminEmail', 'action', 'timestamp'])"
      }
    },
    "priceHistory": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$productId": {
        "$historyId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email_verified === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['productId', 'oldPrice', 'newPrice', 'changedBy', 'timestamp'])"
        }
      }
    },
    "auditLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "phoneReveals": {
        "$revealId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['adminEmail', 'customerPhone', 'timestamp'])"
        }
      }
    },
    "searchMisses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$missId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['term', 'timestamp']) && newData.child('term').isString() && newData.child('term').val().length <= 60"
      }
    }
  }
}